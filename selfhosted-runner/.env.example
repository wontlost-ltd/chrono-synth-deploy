# Copy to .env on the Synology and fill in.
# .env is gitignored — do NOT commit.

# The repo this runner registers against. Switch to org-scope later if needed.
REPO_URL=https://github.com/Wontlost-LTD/chrono-synth-os

# Registration token from GitHub:
#   Settings -> Actions -> Runners -> "New self-hosted runner"
# Token expires after 1 hour, so paste it here right before bringing the
# stack up. After registration, the token is irrelevant — the runner uses
# its own internal credential to talk to GitHub on subsequent connections.
RUNNER_TOKEN=

# Suffix for runner name; bump if you run multiple parallel runners on the
# same NAS (e.g. RUNNER_SUFFIX=2 for a second container).
RUNNER_SUFFIX=1
