# ChronoSynth 本地原生 Podman 环境配置
# 使用前：
#   cp podman/.env.example podman/.env
# 建议配合：
#   docs/podman-manual-test.md
#   docs/podman-reference.md

# ========== 端口 ==========
# 如与本地已有服务冲突，修改这些端口
# 启动后可访问:
# - Web: http://localhost:${FRONTEND_PORT:-8088}
# - Persona Core: http://localhost:${FRONTEND_PORT:-8088}/persona-core
# - Marketplace: http://localhost:${FRONTEND_PORT:-8088}/marketplace
# - Worker: http://localhost:${FRONTEND_PORT:-8088}/worker/healthz
# - Prometheus: http://localhost:${FRONTEND_PORT:-8088}/prometheus/targets
# - Grafana: http://localhost:${FRONTEND_PORT:-8088}/grafana/d/chrono-synth-overview/chrono-synth-enterprise-overview
BACKEND_PORT=3100
FRONTEND_PORT=8088
JAEGER_PORT=16686
OTEL_PORT=4319

# ========== 数据库 ==========
# PostgreSQL 本地密码，仅用于开发/手测
PG_PASSWORD=chrono_dev

# ========== JWT ==========
# 本地 JWT 配置；若修改 SECRET，请保证前后端测试用同一套环境
JWT_ENABLED=true
JWT_SECRET=local-dev-jwt-secret-not-for-production
METRICS_SCRAPE_KEY=local-dev-metrics-scrape-key
# 必须是“解码后 32 字节”的 base64 密钥；可用 `openssl rand -base64 32` 重新生成
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 本地企业控制面 / SCIM / E2E 默认使用这把租户专属 key；生产环境请替换为真实 KMS keyring
ENCRYPTION_KEYRING_JSON='{"tenant_e2e_key":"ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA="}'
ENTERPRISE_E2E_KMS_KEY_REF=tenant_e2e_key
# 平台 TenantVault 根密钥（64 位十六进制 = 32 字节）；可用 `openssl rand -hex 32` 重新生成
# 留空则每次启动随机生成（仅适合本地开发；生产环境必须显式设置）
CHRONO_PLATFORM_KEY=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# ========== 日志 ==========
LOG_LEVEL=info

# ========== OTEL ==========
OTEL_ENABLED=true

# ========== LLM (rightcode provider) ==========
# 如需手测 Avatar Autorun / LLM 知识源，请填入可用 API Key
INTELLIGENCE_PROVIDER=openai
INTELLIGENCE_API_KEY=
INTELLIGENCE_BASE_URL=https://right.codes/codex/v1
INTELLIGENCE_MODEL=gpt-5.2

# ========== Stripe（可选，测试模式） ==========
# 从 https://dashboard.stripe.com/test/apikeys 获取测试密钥
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ========== 数据平面权威模式 ==========
# tables_primary（默认）| dual_write | ledger_primary | rollback_tables
# 生产环境按租户通过 Admin API 精细控制，此处为默认值
CHRONO_DATA_PLANE_AUTHORITY_MODE=tables_primary

# ========== BYOK（可选，企业客户） ==========
# KMS 提供方：platform（默认）| aws_kms | gcp_kms | azure_kv | vault
CHRONO_KMS_PROVIDER=platform
# 以下变量按所选 provider 填写，platform 模式下无需填写
# CHRONO_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789:key/...     # aws_kms
# CHRONO_KMS_KEY_NAME=projects/my-proj/locations/global/keyRings/chrono/cryptoKeys/tenant  # gcp_kms
# CHRONO_KMS_VAULT_ADDRESS=https://vault.example.com             # vault
# CHRONO_KMS_VAULT_MOUNT=transit
# CHRONO_KMS_VAULT_KEY_NAME=chrono-tenant-key

# ========== BYOS（可选，企业客户） ==========
# 对象存储提供方：platform（默认）| s3 | gcs | azure_blob | local
CHRONO_STORAGE_PROVIDER=platform
# CHRONO_STORAGE_BUCKET=my-chrono-tenant-bucket                  # s3 / gcs / azure_blob
# CHRONO_STORAGE_REGION=us-east-1                                # s3
# CHRONO_STORAGE_ENCRYPTION_KEY_REF=tenant_storage_key           # 引用 KMS keyring 中的 key

# ========== 企业运维 / 观测 ==========
# OIDC callback 与前端控制台统一入口必须使用 Web 公共地址
SERVER_PUBLIC_URL=http://localhost:8088
WEB_ENVIRONMENT=podman
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ========== 原生 Podman 高级覆盖（可选） ==========
# 如果镜像已提前构建完成，可设为 true 跳过 up 阶段的自动构建
# PODMAN_SKIP_BUILD=false
#
# 运行时镜像覆盖
# BACKEND_IMAGE=ghcr.io/wontlost-ltd/chrono-synth-os:latest
# FRONTEND_IMAGE=ghcr.io/wontlost-ltd/chrono-synth-web:latest
#
# Podman network / volume 命名覆盖
# PODMAN_NETWORK_NAME=chrono-synth-podman
# PODMAN_PG_VOLUME=chrono-synth-pg-data
# PODMAN_REDIS_VOLUME=chrono-synth-redis-data
# PODMAN_REDPANDA_VOLUME=chrono-synth-redpanda-data
# PODMAN_PROMETHEUS_VOLUME=chrono-synth-prometheus-data
# PODMAN_GRAFANA_VOLUME=chrono-synth-grafana-data
#
# 观测组件镜像覆盖
# REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v25.3.10
# 本地 E2E 为了让 worker 在启动后立即消费租户 topic，默认会预创建这些 topic
# REDPANDA_BOOTSTRAP_TOPICS=observability.events tenant-e2e.observability.events
# PROMETHEUS_IMAGE=prom/prometheus:latest
# GRAFANA_IMAGE=grafana/grafana:latest
