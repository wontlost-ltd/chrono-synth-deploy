# ChronoSynth 本地 podman 环境配置
# 使用前：cp .env.example .env && 修改下方配置

# ========== 端口 ==========
# 如与本地已有服务冲突，修改这些端口
BACKEND_PORT=3100
FRONTEND_PORT=8088
JAEGER_PORT=16686
OTEL_PORT=4319

# ========== 数据库 ==========
PG_PASSWORD=chrono_dev

# ========== JWT ==========
JWT_ENABLED=true
JWT_SECRET=local-dev-jwt-secret-not-for-production

# ========== 日志 ==========
LOG_LEVEL=info

# ========== OTEL ==========
OTEL_ENABLED=true

# ========== LLM (rightcode provider) ==========
INTELLIGENCE_PROVIDER=openai
INTELLIGENCE_API_KEY=
INTELLIGENCE_BASE_URL=https://right.codes/codex/v1
INTELLIGENCE_MODEL=gpt-5.2
